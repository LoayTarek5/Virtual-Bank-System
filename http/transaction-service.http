### Initiate then drain the source, so execution fails
POST http://localhost:8083/transactions/transfer/initiation
Content-Type: application/json

{
  "fromAccountId": "{{fromAccountId}}",
  "toAccountId": "{{toAccountId}}",
  "amount": 400.00,
  "description": "Will fail after draining"
}

> {%
    client.test("200 OK", () => client.assert(response.status === 200));
    client.global.set("doomedTransactionId", response.body.transactionId);
%}

### Drain the source account directly
PUT http://localhost:8082/accounts/transfer
Content-Type: application/json

{
  "fromAccountId": "{{fromAccountId}}",
  "toAccountId": "{{toAccountId}}",
  "amount": 470.00
}

> {%
    client.test("200 OK", () => client.assert(response.status === 200));
%}

### Execution now fails on insufficient funds → 400
POST http://localhost:8083/transactions/transfer/execution
Content-Type: application/json

{ "transactionId": "{{doomedTransactionId}}" }

> {%
    client.test("400", () => client.assert(response.status === 400));
    client.test("reason propagated from account-service", () => client.assert(response.body.message.includes("nsufficient")));
%}

### The failed transaction is now FAILED, not retryable
POST http://localhost:8083/transactions/transfer/execution
Content-Type: application/json

{ "transactionId": "{{doomedTransactionId}}" }

> {%
    client.test("400", () => client.assert(response.status === 400));
    client.test("message", () => client.assert(response.body.message === "Transaction has already failed."));
%}

### History for the source account
GET http://localhost:8083/accounts/{{fromAccountId}}/transactions

> {%
    client.test("200 OK", () => client.assert(response.status === 200));
    client.test("array returned", () => client.assert(Array.isArray(response.body)));
    client.test("has entries", () => client.assert(response.body.length > 0));
    client.test("newest first", () => {
        for (let i = 1; i < response.body.length; i++) {
            client.assert(response.body[i - 1].timestamp >= response.body[i].timestamp);
        }
    });
    client.test("contract fields present", () => {
        const t = response.body[0];
        client.assert(t.transactionId !== undefined && t.fromAccountId !== undefined
            && t.toAccountId !== undefined && t.amount !== undefined
            && t.timestamp !== undefined && t.deliveryStatus === "SENT");
    });
%}

### History includes incoming transactions too
GET http://localhost:8083/accounts/{{toAccountId}}/transactions

> {%
    client.test("200 OK", () => client.assert(response.status === 200));
    client.test("has entries", () => client.assert(response.body.length > 0));
%}

