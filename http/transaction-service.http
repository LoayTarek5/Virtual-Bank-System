### Create a source account (account-service)
POST http://localhost:8082/accounts
Content-Type: application/json

{
  "userId": "11111111-1111-1111-1111-111111111111",
  "accountType": "SAVINGS",
  "initialBalance": 500.00
}

> {%
    client.test("201 created", () => client.assert(response.status === 201));
    client.global.set("fromAccountId", response.body.accountId);
%}

### Create a destination account (account-service)
POST http://localhost:8082/accounts
Content-Type: application/json

{
  "userId": "11111111-1111-1111-1111-111111111111",
  "accountType": "CHECKING",
  "initialBalance": 50.00
}

> {%
    client.test("201 created", () => client.assert(response.status === 201));
    client.global.set("toAccountId", response.body.accountId);
%}

### Initiate a transfer — happy path
POST http://localhost:8083/transactions/transfer/initiation
Content-Type: application/json

{
  "fromAccountId": "{{fromAccountId}}",
  "toAccountId": "{{toAccountId}}",
  "amount": 30.00,
  "description": "Transfer to checking account"
}

> {%
    client.test("200 OK", () => client.assert(response.status === 200));
    client.test("status is Initiated", () => client.assert(response.body.status === "Initiated"));
    client.test("transactionId returned", () => client.assert(response.body.transactionId !== undefined));
    client.test("timestamp is ISO-8601", () => client.assert(/^\d{4}-\d{2}-\d{2}T/.test(response.body.timestamp)));
    client.global.set("transactionId", response.body.transactionId);
%}

### Unknown from-account → 400
POST http://localhost:8083/transactions/transfer/initiation
Content-Type: application/json

{
  "fromAccountId": "99999999-9999-9999-9999-999999999999",
  "toAccountId": "{{toAccountId}}",
  "amount": 10.00,
  "description": "Bad source"
}

> {%
    client.test("400", () => client.assert(response.status === 400));
    client.test("envelope", () => client.assert(response.body.error === "Bad Request"));
%}

