### Same account on both sides → 400
POST http://localhost:8083/transactions/transfer/initiation
Content-Type: application/json

{
  "fromAccountId": "{{fromAccountId}}",
  "toAccountId": "{{fromAccountId}}",
  "amount": 10.00,
  "description": "Self transfer"
}

> {%
    client.test("400", () => client.assert(response.status === 400));
    client.test("message", () => client.assert(response.body.message === "Cannot transfer to the same account."));
%}

### Execute the initiated transfer — happy path
POST http://localhost:8083/transactions/transfer/execution
Content-Type: application/json

{ "transactionId": "{{transactionId}}" }

> {%
    client.test("200 OK", () => client.assert(response.status === 200));
    client.test("status is Success", () => client.assert(response.body.status === "Success"));
    client.test("same transactionId", () => client.assert(response.body.transactionId === client.global.get("transactionId")));
%}

### Balance moved on the source account
GET http://localhost:8082/accounts/{{fromAccountId}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200));
    client.test("debited by 30", () => client.assert(response.body.balance === 470.00));
%}

### Balance moved on the destination account
GET http://localhost:8082/accounts/{{toAccountId}}

> {%
    client.test("credited by 30", () => client.assert(response.body.balance === 80.00));
%}

### Re-executing the same transaction → 400
POST http://localhost:8083/transactions/transfer/execution
Content-Type: application/json

{ "transactionId": "{{transactionId}}" }

> {%
    client.test("400", () => client.assert(response.status === 400));
    client.test("message", () => client.assert(response.body.message === "Transaction has already been executed."));
%}

